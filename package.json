{
  "name": "resona",
  "description": "Resona — offline music player with slide-in panel",
  "author": "Resona",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.electron.json",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "free:port": "node scripts/free-vite-port.mjs",
    "electron:dev": "npm run free:port && npm run icons && npm run electron:compile && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --disable-http-cache\"",
    "electron:build": "npm run icons && node scripts/generate-installer-assets.mjs && npm run build && electron-builder --config electron-builder.json",
    "icons": "node scripts/generate-icons.mjs && node scripts/brand-electron.mjs",
    "brand:electron": "node scripts/brand-electron.mjs",
    "postinstall": "node scripts/brand-electron.mjs",
    "installer:assets": "node scripts/generate-installer-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-slider": "1.2.3",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "music-metadata": "^11.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "^1.3.8",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.1.2",
    "electron": "35.1.5",
    "electron-builder": "26.0.12",
    "jsdom": "26.1.0",
    "png-to-ico": "^2.1.8",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.2",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "wait-on": "8.0.3"
  }
}
