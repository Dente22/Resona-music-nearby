{
  "appId": "com.resona.player",
  "productName": "Resona",
  "copyright": "Copyright © 2026 Resona",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "electron/preload.cjs",
    "build/icon.png",
    "build/icon.ico"
  ],
  "asarUnpack": [
    "build/icon.png",
    "build/icon.ico"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icons/icon.png"
    }
  ],
  "icon": "build/icon.png",
  "artifactName": "${productName}-${version}-${os}.${ext}",
  "afterPack": "./scripts/afterPack.mjs",
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "category": "AudioVideo",
    "icon": "build/icon.png",
    "executableName": "resona",
    "synopsis": "Resona — музыка рядом",
    "desktop": {
      "entry": {
        "Name": "Resona",
        "Comment": "Музыка рядом — панель с края экрана",
        "Categories": "AudioVideo;Audio;Player;",
        "StartupWMClass": "resona"
      }
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false,
    "icon": "build/icon.ico",
    "executableName": "Resona",
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "electron/bin/win-app-volume.exe",
        "to": "bin/win-app-volume.exe"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Resona",
    "menuCategory": "Resona",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "installerHeader": "build/installerHeader.bmp",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/installerSidebar.bmp",
    "license": "LICENSE",
    "displayLanguageSelector": true,
    "installerLanguages": ["ru_RU", "en_US"],
    "include": "build/installer.nsh"
  }
}
